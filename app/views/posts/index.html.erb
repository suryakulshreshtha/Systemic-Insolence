<header class="page-header">
  <h1 class="page-title">Blog</h1>
  <p class="muted"><a href="/feed.xml">Subscribe with the feed</a></p>
</header>

<% if @posts.any? %>
  <% @posts.group_by { |post| post.date.year }.each do |year, posts| %>
    <section class="section" aria-labelledby="year-<%= year %>">
      <h2 class="section__label" id="year-<%= year %>"><%= year %></h2>
      <div class="section__body">
        <ul class="post-list">
          <% posts.each do |post| %>
            <li>
              <time class="post-list__date" datetime="<%= iso_date(post.date) %>"><%= short_date(post.date) %></time>
              <a class="post-list__title" href="<%= post_path(post.slug) %>"><%= post.title %></a>
              <% if post.summary.present? %>
                <p class="post-list__summary"><%= post.summary %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>
<% else %>
  <p class="muted">Nothing published yet.</p>
<% end %>
