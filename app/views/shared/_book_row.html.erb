<ul class="book-row">
  <% books.each do |book| %>
    <li class="book">
      <% cover = book["cover"] ? image_tag_for(book["cover"], alt: "Cover of #{book['title']}", class: "book__cover") : nil %>
      <% target = safe_url(book["url"], allow_site_path: false) %>
      <% if target %>
        <a class="book__link" href="<%= target %>" rel="noopener noreferrer">
          <%= cover || tag.span(book["title"], class: "book__cover book__cover--blank") %>
        </a>
      <% else %>
        <%= cover || tag.span(book["title"], class: "book__cover book__cover--blank") %>
      <% end %>
      <p class="book__title"><%= book["title"] %></p>
      <% if book["author"].present? %>
        <p class="book__author"><%= book["author"] %></p>
      <% end %>
    </li>
  <% end %>
</ul>
